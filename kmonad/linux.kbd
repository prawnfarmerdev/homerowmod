;; KMonad configuration for Homerow Mods (Linux)
;; Based on https://precondition.github.io/home-row-mods
;; GACS order: GUI, Alt, Control, Shift on left hand; mirrored on right hand
;; Includes gaming layer (toggle with Caps Lock hold)

(defcfg
  ;; For Linux - use device-file for input, uinput-sink for output
  
  input  (device-file "/dev/input/by-id/usb-ASUSTeK_Computer_Inc._N-KEY_Device-if02-event-kbd")
  output (uinput-sink "KMonad Homerow Mods")

  ;; Let non-configured keys act normal
  fallthrough true
)

(defsrc
    esc   tab   caps   a    s    d    f    g    h    j    k    l    ;    ret
)

(defalias
    met_a (tap-hold-next-release 200 a lmet)
    alt_s (tap-hold-next-release 200 s lalt)
    ctl_d (tap-hold-next-release 200 d lctl)
    sft_f (tap-hold-next-release 200 f lsft)

    sft_j (tap-hold-next-release 200 j rsft)
    ctl_k (tap-hold-next-release 200 k rctl)
    alt_l (tap-hold-next-release 200 l lalt)
    met_; (tap-hold-next-release 200 ; rmet)
    
    ;; Layer switching - tap for caps lock, hold to toggle gaming layer
    caps_layer (tap-hold-next-release 200 caps (layer-toggle gaming))
)

(deflayer homerowmods
    esc   tab   @caps_layer   @met_a   @alt_s   @ctl_d   @sft_f   g   h   @sft_j   @ctl_k   @alt_l   @met_;   ret
)

(deflayer gaming
    esc   tab   @caps_layer   a   s   d   f   g   h   j   k   l   ;   ret
)